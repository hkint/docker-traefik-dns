# Cloudflare API Token (Must have Zone.DNS Edit permissions)
CF_API_TOKEN=

# Domain filter (comma separated, only sync records under these domains)
DOMAIN_FILTER=

# Target IP to point DNS records to (public WAN IP or local IP)
DEFAULT_TARGET_IP=

# Enable Cloudflare Proxy (orange cloud CDN) by default (true/false)
CF_PROXY=

# Sync interval (e.g. 30s, 60s, 5m)
SYNC_INTERVAL=

# Dry Run mode: preview actions without modifying Cloudflare records
DRY_RUN=

# Log level (debug, info, warn, error)
LOG_LEVEL=
